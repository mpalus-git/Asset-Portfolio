                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="4">
                                    <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <Label Text="Najwyższa cena (dziś):" FontSize="11" TextColor="{AppThemeBinding Light=#888888, Dark=#AAAAAA}" />
                                        <Label Text="{Binding SearchedStock.HighPrice24h, StringFormat='{0:N2}'}" FontSize="11" FontAttributes="Bold" TextColor="#4CAF50" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                        <Label Text="Najniższa cena (dziś):" FontSize="11" TextColor="{AppThemeBinding Light=#888888, Dark=#AAAAAA}" />
                                        <Label Text="{Binding SearchedStock.LowPrice24h, StringFormat='{0:N2}'}" FontSize="11" FontAttributes="Bold" TextColor="#F44336" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                        <Label Text="Max 52 tyg.:" FontSize="11" TextColor="{AppThemeBinding Light=#888888, Dark=#AAAAAA}" />
                                        <Label Text="{Binding SearchedStock.FiftyTwoWeekHigh, StringFormat='{0:N2}'}" FontSize="11" TextColor="#4CAF50" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <Label Text="Min 52 tyg.:" FontSize="11" TextColor="{AppThemeBinding Light=#888888, Dark=#AAAAAA}" />
                                        <Label Text="{Binding SearchedStock.FiftyTwoWeekLow, StringFormat='{0:N2}'}" FontSize="11" TextColor="#F44336" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Spacing="4">
                                        <Label Text="Wolumen:" FontSize="11" TextColor="{AppThemeBinding Light=#888888, Dark=#AAAAAA}" />
                                        <Label Text="{Binding SearchedStock.Volume24h, StringFormat='{0:N0}'}" FontSize="11" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4">
                                        <Label Text="Zmiana:" FontSize="11" TextColor="{AppThemeBinding Light=#888888, Dark=#AAAAAA}" />
                                        <Label Text="{Binding SearchedStock.PriceChange24h, StringFormat='${0:N2}'}" FontSize="11"
                                               TextColor="{Binding SearchedStock.PriceChange24h, Converter={StaticResource PnLColorConverter}}" />
                                    </HorizontalStackLayout>
                                </Grid>
                                <BoxView HeightRequest="1"
                                         BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                                         Margin="0,4,0,4" />
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding SearchedStock.Name, StringFormat='Wykres: {0}'}"
                                           FontSize="14" FontAttributes="Bold" />
                                    <Label Text="{Binding SearchedStockChartInterval, StringFormat='({0})'}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#888888, Dark=#AAAAAA}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <ActivityIndicator IsRunning="{Binding IsSearchedStockChartLoading}"
                                                   IsVisible="{Binding IsSearchedStockChartLoading}"
                                                   HeightRequest="30" WidthRequest="30"
                                                   HorizontalOptions="Center" />
                                <ContentView>
                                    <Grid ColumnDefinitions="Auto,*"
                                          RowDefinitions="*,Auto">
                                        <Grid Grid.Column="0" Grid.Row="0"
                                              RowDefinitions="Auto,*,Auto"
                                              Margin="0,0,6,0">
                                            <Label Grid.Row="0"
                                                   Text="{Binding SearchedStockChartMaxPrice}"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                                                   VerticalOptions="Start" />
                                            <Label Grid.Row="1"
                                                   Text="{Binding SearchedStockChartMidPrice}"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Row="2"
                                                   Text="{Binding SearchedStockChartMinPrice}"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                                                   VerticalOptions="End" />
                                        </Grid>
                                        <microcharts:ChartView Grid.Column="1" Grid.Row="0"
                                                               Chart="{Binding SearchedStockChart}"
                                                               HeightRequest="200"
                                                               HorizontalOptions="Fill" />
                                        <Grid Grid.Column="1" Grid.Row="1"
                                              ColumnDefinitions="*,*,*"
                                              Margin="0,4,0,0">
                                            <Label Grid.Column="0"
                                                   Text="{Binding SearchedChartStartDate}"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                                                   HorizontalOptions="Start" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding SearchedChartMidDate}"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                                                   HorizontalOptions="Center" />
                                            <Label Grid.Column="2"
                                                   Text="{Binding SearchedChartEndDate}"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                                                   HorizontalOptions="End" />
                                        </Grid>
                                    </Grid>
                                </ContentView>
                                <HorizontalStackLayout Spacing="16"
                                                       HorizontalOptions="Center"
                                                       Margin="0,8,0,0">
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="📈" FontSize="12" VerticalOptions="Center" />
                                        <Label Text="Oś Y: Cena"
                                               FontSize="10"
                                               TextColor="{AppThemeBinding Light=#888888, Dark=#AAAAAA}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="📅" FontSize="12" VerticalOptions="Center" />
                                        <Label Text="Oś X: Data (dd.mm)"
                                               FontSize="10"
                                               TextColor="{AppThemeBinding Light=#888888, Dark=#AAAAAA}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Button Text="24h"
                                            Command="{Binding ChangeSearchedStockChartIntervalCommand}"
                                            CommandParameter="24h"
                                            BackgroundColor="{Binding SearchedStockChartInterval, Converter={StaticResource StockIntervalToColorConverter}, ConverterParameter=24h}"
                                            TextColor="White"
                                            FontSize="12"
                                            CornerRadius="4"
                                            Padding="12,6"
                                            HeightRequest="32" />
                                    <Button Text="1tyd."
                                            Command="{Binding ChangeSearchedStockChartIntervalCommand}"
                                            CommandParameter="1tyd."
                                            BackgroundColor="{Binding SearchedStockChartInterval, Converter={StaticResource StockIntervalToColorConverter}, ConverterParameter=1tyd.}"
                                            TextColor="White"
                                            FontSize="12"
                                            CornerRadius="4"
                                            Padding="12,6"
                                            HeightRequest="32" />
                                    <Button Text="1msc."
                                            Command="{Binding ChangeSearchedStockChartIntervalCommand}"
                                            CommandParameter="1msc."
                                            BackgroundColor="{Binding SearchedStockChartInterval, Converter={StaticResource StockIntervalToColorConverter}, ConverterParameter=1msc.}"
                                            TextColor="White"
                                            FontSize="12"
                                            CornerRadius="4"
                                            Padding="12,6"
                                            HeightRequest="32" />
                                    <Button Text="1rok"
                                            Command="{Binding ChangeSearchedStockChartIntervalCommand}"
                                            CommandParameter="1rok"
                                            BackgroundColor="{Binding SearchedStockChartInterval, Converter={StaticResource StockIntervalToColorConverter}, ConverterParameter=1rok}"
                                            TextColor="White"
                                            FontSize="12"
                                            CornerRadius="4"
                                            Padding="12,6"
                                            HeightRequest="32" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>